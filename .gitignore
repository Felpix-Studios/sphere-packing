# macOS metadata
.DS_Store
._*
.Spotlight-V100/
.Trashes/

# Local editor settings and temporary files
.idea/
.vscode/
*.swp
*.swo
*~

# LaTeX intermediates; publish the paper source alongside the PDF
# Scope .log/.out to the paper: verifier evidence may use these extensions.
*.tex
*.aux
/preprints/*/paper.log
/preprints/*/paper.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.bcf
*.blg
*.run.xml

# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Local environment variables
.env
.env.*
!.env.example

# arXiv submission
/arxiv

# Lean build output
.lake/

# Publish certificate JSON, Python/C++ checkers, Lean sources and paper.tex.
# Do not ignore verify/, data/, lean/, or their source/data extensions.
# Lean compiler artifacts when a build is directed outside .lake
*.olean
*.ilean
*.trace
