def gaugeTabList (k : Nat) : List Rat :=
  match k with
  | 0 => tab0List
  | 1 => tab1List
  | 2 => tab2List
  | 3 => tab3List
  | 4 => tab4List
  | 5 => tab5List
  | 6 => tab6List
  | _ => []

def gaugeTab (k : Nat) : Array Rat := (gaugeTabList k).toArray

/-- Minimum of `tab[base + i]`, `i < n`, starting from `acc`. -/
def minRange (tab : Array Rat) (base : Nat) : Nat → Rat → Rat
  | 0, acc => acc
  | n + 1, acc => minRange tab base n (min acc (tab.getD (base + n) 0))

/-- Lower bound of the gauge weight on the dyadic box `[num/2^lev, (num+1)/2^lev]` of the unit
coordinate of a region whose table has depth `D`. -/
def gaugeLoDy (tab : Array Rat) (D num lev : Nat) : Rat :=
  if D ≤ lev then tab.getD (num / 2 ^ (lev - D)) 0
  else minRange tab (num * 2 ^ (D - lev)) (2 ^ (D - lev)) (tab.getD (num * 2 ^ (D - lev)) 0)

end D4Bound.GaugeTab
