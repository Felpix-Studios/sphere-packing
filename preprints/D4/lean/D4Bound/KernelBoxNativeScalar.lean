import D4Bound.KernelBoxNativeModel
import Mathlib.Analysis.Complex.Exponential

/-!
# A polynomial upper bound for the scalar part of the gauge

`scalarRadius r = exp (-2 r²) F (2 r²)` is bounded above on `r ∈ [1, R5]` by the degree-14
polynomial `ghat (r - 1)`. The proof combines Mathlib's `Real.exp_bound` (Taylor remainder for
`exp`), a rational enclosure of `exp (-1)`, and an executable one-variable positivity check
`scalarCheck` of `ghat - eM·G - errS` on `[0, R5 - 1]`. `scalar_upper_of_check` uses only the
standard axioms; `scalarCheck = true` is established by `native_decide` elsewhere.
-/

namespace D4Bound.KBN
open V7

/-- Generated by `kernelbox-native/make_ghat.py` (Chebyshev fit plus `2⁻⁴⁶`); any list works,
the check below decides whether it is an upper bound. -/
def ghat : P1 := [(160554300821448053337709949 / 1237940039285380274899124224 : ℚ), (-924924074189899547011779073 / 1237940039285380274899124224 : ℚ), (1962343254749826418448646917 / 1237940039285380274899124224 : ℚ), (-715416872771004226050711257 / 618970019642690137449562112 : ℚ), (-982693860392214703576826181 / 1237940039285380274899124224 : ℚ), (2133411792164743894534262801 / 1237940039285380274899124224 : ℚ), (-233736397657269345777796817 / 618970019642690137449562112 : ℚ), (-550401697014274976596095407 / 618970019642690137449562112 : ℚ), (573932475309347230109559771 / 1237940039285380274899124224 : ℚ), (365631114384670497621289005 / 1237940039285380274899124224 : ℚ), (-190639085908908317767737743 / 1237940039285380274899124224 : ℚ), (-169595586098988174266643551 / 618970019642690137449562112 : ℚ), (-55086020955347062929191999 / 1237940039285380274899124224 : ℚ), (95548168647569527130660117 / 154742504910672534362390528 : ℚ), (-62886150398621550386147943 / 618970019642690137449562112 : ℚ)]

def expN : ℕ := 10
def wP : P1 := [0, -4, -2]
def TP : P1 :=
  psum qAlg ((List.range expN).map fun i => A1.smul (1 / (Nat.factorial i : ℚ)) (ppow qAlg wP i))
def FcP : P1 := horner A1 (fun q : ℚ => [q]) [2, 4, 2] Fq
def GP : P1 := A1.mul TP FcP

def em : ℕ := 30
def aQ : ℚ := ((List.range em).map fun i => (-1 : ℚ) ^ i / (Nat.factorial i : ℚ)).sum
def d1Q : ℚ := ((em : ℚ) + 1) / ((Nat.factorial em : ℚ) * em)
def eM : ℚ := aQ ^ 2
def epsE : ℚ := d1Q * (2 * aQ + d1Q)
def eHi : ℚ := (aQ + d1Q) ^ 2
def umax : ℚ := 2597 / 100000
def xmax : ℚ := 4 * umax + 2 * umax ^ 2
def rhoQ : ℚ := xmax ^ expN * (((expN : ℚ) + 1) / ((Nat.factorial expN : ℚ) * expN))
def MG : ℚ := abs1 (umax / 2) (pshift qAlg (umax / 2) GP)
def MF : ℚ := abs1 (umax / 2) (pshift qAlg (umax / 2) FcP)
def errS : ℚ := epsE * MG + eHi * rhoQ * MF
def gapP : P1 := A1.add ghat (A1.add (A1.smul (-eM) GP) [-errS])

def search1 (p : P1) : ℕ → ℚ → ℚ → Bool
  | 0, c, h => decide (0 ≤ low1 h (pshift qAlg c p))
  | n + 1, c, h => decide (0 ≤ low1 h (pshift qAlg c p)) ||
      (search1 p n (c - h / 2) (h / 2) && search1 p n (c + h / 2) (h / 2))

theorem search1_sound (p : P1) : ∀ (n : ℕ) (c h : ℚ), search1 p n c h = true →
    ∀ x : ℝ, |x - c| ≤ h → 0 ≤ E1 p x
  | 0, c, h, hs, x, hx => by
    have h0 : (0 : ℝ) ≤ (low1 h (pshift qAlg c p) : ℝ) := by
      exact_mod_cast (decide_eq_true_eq.mp hs)
    linarith [low1_shift_sound hx p]
  | n + 1, c, h, hs, x, hx => by
    simp only [search1, Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq] at hs
    rcases hs with hs | ⟨h1, h2⟩
    · have h0 : (0 : ℝ) ≤ (low1 h (pshift qAlg c p) : ℝ) := by exact_mod_cast hs
      linarith [low1_shift_sound hx p]
    · rcases half_cover' hx with hx' | hx'
      · exact search1_sound p n _ _ h1 x (by push_cast; exact hx')
      · exact search1_sound p n _ _ h2 x (by push_cast; exact hx')
where
  half_cover' {x c h : ℝ} (hx : |x - c| ≤ h) :
      |x - (c - h / 2)| ≤ h / 2 ∨ |x - (c + h / 2)| ≤ h / 2 := by
    rw [abs_le] at hx
    by_cases hc : x ≤ c
    · left; rw [abs_le]; constructor <;> linarith
    · right; rw [abs_le]; constructor <;> linarith

def scalarCheck : Bool :=
  search1 gapP 14 (umax / 2) (umax / 2) && decide (xmax ≤ 1) && decide (0 ≤ aQ)

theorem list_range_sum (f : ℕ → ℝ) : ∀ n : ℕ,
    ((List.range n).map f).sum = ∑ m ∈ Finset.range n, f m
  | 0 => by simp
  | n + 1 => by
    rw [List.range_succ, List.map_append, List.sum_append, Finset.sum_range_succ,
      list_range_sum f n]
    simp

theorem evalQ_eq (L : List ℚ) (x : ℝ) : evalQ L x = peval (fun q : ℚ => (q : ℝ)) x L := by
  induction L with
  | nil => simp [evalQ]
  | cons a L ih => simp [evalQ, ih]

theorem E1_FcP (r : ℝ) : E1 FcP (r - 1) = F (2 * r ^ 2) := by
  unfold FcP F
  rw [evalQ_eq]
  have h := eval_horner (M1 (r - 1)) (fun q : ℚ => [q]) (ev := fun q : ℚ => (q : ℝ))
    (fun q => E1_singleton q _) [2, 4, 2] Fq
  have harg : E1 [2, 4, 2] (r - 1) = 2 * r ^ 2 := by
    simp only [E1, peval_cons, peval_nil]; push_cast; ring
  rw [h, harg]

theorem E1_TP (r : ℝ) : E1 TP (r - 1) =
    ∑ m ∈ Finset.range expN, (2 - 2 * r ^ 2) ^ m / (m.factorial : ℝ) := by
  unfold TP
  rw [E1_psum, List.map_map, ← list_range_sum]
  apply congrArg List.sum
  apply List.map_congr_left
  intro i _
  simp only [Function.comp, E1_smul, E1_ppow]
  have : E1 wP (r - 1) = 2 - 2 * r ^ 2 := by
    simp only [wP, E1, peval_cons, peval_nil]; push_cast; ring
  rw [this]
  push_cast; ring

theorem aQ_cast : (aQ : ℝ) = ∑ m ∈ Finset.range em, (-1 : ℝ) ^ m / (m.factorial : ℝ) := by
  unfold aQ
  rw [cast_sum_map, ← list_range_sum]
  apply congrArg List.sum
  apply List.map_congr_left
  intro i _
  push_cast; ring

theorem abs_bound_of_shift {p : P1} {x : ℝ} (hx : |x - (umax / 2 : ℚ)| ≤ (umax / 2 : ℚ)) :
    |E1 p x| ≤ (abs1 (umax / 2) (pshift qAlg (umax / 2) p) : ℝ) := by
  have := (bounds1 hx (pshift qAlg (umax / 2) p)).2
  rwa [E1_pshift, add_sub_cancel] at this

theorem scalar_upper_of_check (hc : scalarCheck = true) : ScalarUpper ghat := by
  simp only [scalarCheck, Bool.and_eq_true, decide_eq_true_eq] at hc
  obtain ⟨⟨hs, hxm⟩, ha0⟩ := hc
  intro r h1 h2
  have hu : |(r - 1) - ((umax / 2 : ℚ) : ℝ)| ≤ ((umax / 2 : ℚ) : ℝ) := by
    simp only [umax]; push_cast; rw [abs_le]; constructor <;> linarith
  have hgap := search1_sound gapP 14 _ _ hs (r - 1) hu
  simp only [gapP, E1_add, E1_smul, E1_singleton] at hgap
  -- Taylor remainder for exp on 2 - 2 r²
  have hxabs : |2 - 2 * r ^ 2| ≤ (xmax : ℝ) := by
    simp only [xmax, umax]; push_cast
    rw [abs_le]; constructor <;> nlinarith
  have hx1 : |2 - 2 * r ^ 2| ≤ 1 := le_trans hxabs (by exact_mod_cast hxm)
  have hT := Real.exp_bound hx1 (n := expN) (by norm_num [expN])
  rw [← E1_TP] at hT
  have hrho : |2 - 2 * r ^ 2| ^ expN * ((expN.succ : ℝ) / ((expN.factorial : ℝ) * expN)) ≤
      (rhoQ : ℝ) := by
    unfold rhoQ
    push_cast
    apply mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (abs_nonneg _) hxabs _)
    positivity
  -- exp(-1) enclosure
  have hE := Real.exp_bound (x := -1) (by norm_num) (n := em) (by norm_num [em])
  rw [← aQ_cast] at hE
  simp only [abs_neg, abs_one, one_pow, one_mul] at hE
  have hd1 : ((em.succ : ℝ) / ((em.factorial : ℝ) * em)) = (d1Q : ℝ) := by
    unfold d1Q; push_cast; ring
  rw [hd1] at hE
  have ha0' : (0 : ℝ) ≤ aQ := by exact_mod_cast ha0
  have hd0 : (0 : ℝ) ≤ d1Q := by unfold d1Q; positivity
  have he1pos : 0 < Real.exp (-1) := Real.exp_pos _
  obtain ⟨hE1, hE2⟩ := abs_le.mp hE
  have hexp2 : Real.exp (-2 * r ^ 2) = Real.exp (-1) ^ 2 * Real.exp (2 - 2 * r ^ 2) := by
    rw [← Real.exp_nat_mul, ← Real.exp_add,
      show ((2 : ℕ) : ℝ) * -1 + (2 - 2 * r ^ 2) = -2 * r ^ 2 by push_cast; ring]
  have heps : |Real.exp (-1) ^ 2 - (eM : ℝ)| ≤ (epsE : ℝ) := by
    unfold eM epsE; push_cast
    rw [show Real.exp (-1) ^ 2 - (aQ : ℝ) ^ 2 = (Real.exp (-1) - aQ) * (Real.exp (-1) + aQ) by ring,
      abs_mul]
    have : |Real.exp (-1) + (aQ : ℝ)| ≤ 2 * aQ + d1Q := by
      rw [abs_of_nonneg (by linarith)]; linarith
    exact mul_le_mul hE this (abs_nonneg _) hd0
  have hehi : Real.exp (-1) ^ 2 ≤ (eHi : ℝ) := by
    unfold eHi; push_cast
    exact pow_le_pow_left₀ he1pos.le (by linarith) 2
  -- assemble
  have hG : |E1 GP (r - 1)| ≤ (MG : ℝ) := abs_bound_of_shift hu
  have hF : |E1 FcP (r - 1)| ≤ (MF : ℝ) := abs_bound_of_shift hu
  have hGe : E1 GP (r - 1) = E1 TP (r - 1) * F (2 * r ^ 2) := by
    rw [GP, E1_mul, E1_FcP]
  have he0 : 0 ≤ Real.exp (-1) ^ 2 := by positivity
  have hsr : scalarRadius r = Real.exp (-1) ^ 2 * (E1 TP (r - 1) * F (2 * r ^ 2)) +
      Real.exp (-1) ^ 2 * ((Real.exp (2 - 2 * r ^ 2) - E1 TP (r - 1)) * F (2 * r ^ 2)) := by
    unfold scalarRadius; rw [hexp2]; ring
  rw [hsr]
  have herr : (errS : ℝ) = epsE * MG + eHi * rhoQ * MF := by unfold errS; push_cast; ring
  rw [E1_FcP] at hF
  rw [hGe] at hG hgap
  push_cast at hgap
  rw [herr] at hgap
  have hδb := le_trans hT hrho
  generalize E1 TP (r - 1) = T at hδb hG hgap ⊢
  generalize F (2 * r ^ 2) = Fv at hF hG hgap ⊢
  generalize Real.exp (2 - 2 * r ^ 2) - T = δ at hδb ⊢
  generalize Real.exp (-1) ^ 2 = e at heps hehi he0 ⊢
  have hepsE : (0 : ℝ) ≤ epsE := le_trans (abs_nonneg _) heps
  have hrho0 : (0 : ℝ) ≤ rhoQ := le_trans (abs_nonneg _) hδb
  have k1 : e * (T * Fv) ≤ (eM : ℝ) * (T * Fv) + (epsE : ℝ) * (MG : ℝ) := by
    have h3 : |(e - eM) * (T * Fv)| ≤ (epsE : ℝ) * (MG : ℝ) := by
      rw [abs_mul]; exact mul_le_mul heps hG (abs_nonneg _) hepsE
    have := le_abs_self ((e - eM) * (T * Fv))
    nlinarith
  have k2 : e * (δ * Fv) ≤ (eHi : ℝ) * (rhoQ : ℝ) * (MF : ℝ) := by
    have h3 : |δ * Fv| ≤ (rhoQ : ℝ) * MF := by
      rw [abs_mul]; exact mul_le_mul hδb hF (abs_nonneg _) hrho0
    have h5 : (0 : ℝ) ≤ rhoQ * MF := le_trans (abs_nonneg _) h3
    have h4 : e * (δ * Fv) ≤ e * (rhoQ * MF) :=
      mul_le_mul_of_nonneg_left (le_trans (le_abs_self _) h3) he0
    have h6 : e * (rhoQ * MF) ≤ eHi * (rhoQ * MF) := mul_le_mul_of_nonneg_right hehi h5
    nlinarith
  linarith

end D4Bound.KBN
