theorem pair24_identity :
    pair24.map ((scalarPowerDen24*originDen24*featureDen24^2)*·) =
      (pairNum scalarPower24 rays24 scalarPowerDen24 originDen24 featureDen24).map (pair24Den*·) := by decide +kernel

theorem rawPair24_nonpos (t : ℝ) (hlo : -1≤t) (hhi : t≤203/400) :
    evalZ scalarPower24 t/scalarPowerDen24 +
      2*SphereCertificate.coupling Finset.univ (rayDegree rays24) (rayO rays24 originDen24) (rayV rays24 featureDen24) t +
      SphereCertificate.kernel Finset.univ (rayDegree rays24) (rayV rays24 featureDen24) t t 1 ≤ 0 := by
  apply rawPair_nonpos_of_identity scalarPower24 pair24 rays24 scalarPowerDen24 originDen24 featureDen24 pair24Den
  · norm_num [scalarPowerDen24]
  · norm_num [originDen24]
  · norm_num [featureDen24]
  · norm_num [pair24Den]
  · exact pair24_identity
  · exact pair24_nonpos t hlo hhi

#print axioms rawPair24_nonpos

