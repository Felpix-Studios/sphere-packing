namespace D4Bound.SphericalSurplusSign
open SphericalSign

def pairCorrection1 : List ℤ := [-1]
def pairCorrectionDen1 : ℤ := 1000000

theorem pairCorrection1_value (x : ℝ) :
    evalZ pairCorrection1 x/pairCorrectionDen1 =
      2*v1+b1+(2-2*(countM1:ℝ))*F1 x-(eta1:ℝ) := by
  norm_num [pairCorrection1,pairCorrectionDen1,v1,b1,F1,countM1,
    vNum1,bNum1,originDen1,correction1,correctionDen1,eta1,evalZ]

theorem pair1_identity :
    pair1.map ((scalarPowerDen1*originDen1*featureDen1^2*pairCorrectionDen1)*·) =
      (correctedPairNum scalarPower1 pairCorrection1 rays1 scalarPowerDen1
        originDen1 featureDen1 pairCorrectionDen1).map (pairDen1*·) := by decide +kernel

theorem rawPair1_le (x : ℝ) (hlo : -1≤x) (hhi : x≤21/40) :
    (g1 x + 2*coupling1 x + kernel1 x x 1) ≤ (eta1:ℝ) := by
  have h := corrected_pair_nonpos scalarPower1 pairCorrection1 pair1 rays1
    scalarPowerDen1 originDen1 featureDen1 pairCorrectionDen1 pairDen1
    (by norm_num [scalarPowerDen1]) (by norm_num [originDen1])
    (by norm_num [featureDen1]) (by norm_num [pairCorrectionDen1])
    (by norm_num [pairDen1]) pair1_identity x (pair1_nonpos x hlo hhi)
  rw [pairCorrection1_value] at h
  dsimp [g1,coupling1,kernel1]
  linarith

