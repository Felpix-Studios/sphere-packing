import D4Bound.CensusEnvelope
/-! The exact 27 by 5 table of applicable spherical surplus maxima.
This is rational arithmetic only; the analytic bounds are proved separately. -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option Elab.async false
namespace D4Bound.SphericalSurplusTable
open CensusArithmetic

def W : ℚ := (14871048439109842089/2500000000000000000000)

def B : ℚ := (24011149331270334059543053650135728526049/4444400000000000000000000000000000000000000)

def raw0 : ℚ := (130877701570004888847033217319318784541/148723869673221832089000000000000000000)

def repaired0 : ℚ := (131430224020549714328939307470798784541/148723869673221832089000000000000000000)

def epsilon0 : ℚ := (3/500000)

def eta0 : ℚ := (1/1000000)

def credit0 (n : ℕ) : ℚ := max (n*(B-W*repaired0)) (n*B-W*(n*raw0+eta0*n*(n-1)+epsilon0*n*(n-1)*(n-2)))

def raw1 : ℚ := (65914448509406451575062474686557247029/74361934836610916044500000000000000000)

def repaired1 : ℚ := (7346139720652490896946358445506360781/8262437204067879560500000000000000000)

def epsilon1 : ℚ := (1/250000)

def eta1 : ℚ := (1/1000000)

def credit1 (n : ℕ) : ℚ := max (n*(B-W*repaired1)) (n*B-W*(n*raw1+eta1*n*(n-1)+epsilon1*n*(n-1)*(n-2)))

def raw2 : ℚ := (32684678624403525301964627843417351227/37180967418305458022250000000000000000)

def repaired2 : ℚ := (32781066933107189220742908478457351227/37180967418305458022250000000000000000)

def epsilon2 : ℚ := (1/250000)

def eta2 : ℚ := (1/1000000)

def credit2 (n : ℕ) : ℚ := max (n*(B-W*repaired2)) (n*B-W*(n*raw2+eta2*n*(n-1)+epsilon2*n*(n-1)*(n-2)))

def scaleFactor : ℤ := 11111

def scaleDen : ℤ := 

def scaledCredit0 (n : ℕ) : ℤ := max (n*) (n*-*n*(n-1)-*n*(n-1)*(n-2))

theorem credit_scaled0 (n : ℕ) :
    (scaleDen:ℝ)*(credit0 n:ℝ) = (scaledCredit0 n:ℝ) := by
  unfold credit0 scaledCredit0
  push_cast
  rw [mul_max_of_nonneg _ _ (by norm_num [scaleDen] : (0:ℝ)≤scaleDen)]
  congr 1 <;> norm_num [scaleDen,B,W,repaired0,raw0,epsilon0,eta0] <;> ring

def scaledCredit1 (n : ℕ) : ℤ := max (n*) (n*-*n*(n-1)-*n*(n-1)*(n-2))

theorem credit_scaled1 (n : ℕ) :
    (scaleDen:ℝ)*(credit1 n:ℝ) = (scaledCredit1 n:ℝ) := by
  unfold credit1 scaledCredit1
  push_cast
  rw [mul_max_of_nonneg _ _ (by norm_num [scaleDen] : (0:ℝ)≤scaleDen)]
  congr 1 <;> norm_num [scaleDen,B,W,repaired1,raw1,epsilon1,eta1] <;> ring

def scaledCredit2 (n : ℕ) : ℤ := max (n*) (n*-*n*(n-1)-*n*(n-1)*(n-2))

theorem credit_scaled2 (n : ℕ) :
    (scaleDen:ℝ)*(credit2 n:ℝ) = (scaledCredit2 n:ℝ) := by
  unfold credit2 scaledCredit2
  push_cast
  rw [mul_max_of_nonneg _ _ (by norm_num [scaleDen] : (0:ℝ)≤scaleDen)]
  congr 1 <;> norm_num [scaleDen,B,W,repaired2,raw2,epsilon2,eta2] <;> ring

def available (n j : ℕ) : ℚ :=
  max 0 (max (credit1 n) (max (if n=24 ∧ j≤1 then credit0 n else 0)
    (if n=25 ∧ j≤4 then credit2 n else 0)))

def scaledAvailable (n j : ℕ) : ℤ :=
  max 0 (max (scaledCredit1 n) (max (if n=24 ∧ j≤1 then scaledCredit0 n else 0)
    (if n=25 ∧ j≤4 then scaledCredit2 n else 0)))

theorem available_scaled (n j : ℕ) :
    (scaleDen:ℝ)*(available n j:ℝ) = (scaledAvailable n j:ℝ) := by
  unfold available scaledAvailable
  push_cast
  split_ifs <;>
    simp only [Rat.cast_zero,Int.cast_zero,mul_max_of_nonneg _ _ (by norm_num [scaleDen] : (0:ℝ)≤scaleDen),
      mul_zero,credit_scaled0,credit_scaled1,credit_scaled2]

theorem table_checked : ∀ n : Fin 27, ∀ j : Fin 5,
    surplusNumerators[5*n.val+j.val]!*scaleFactor ≤ scaledAvailable n.val (j.val+1) := by
  decide +kernel

lemma first_pos (v : Counts) : 1 ≤ first v := by
  unfold first
  split_ifs <;> omega
lemma first_le_five (v : Counts) : first v ≤ 5 := by
  unfold first
  split_ifs <;> omega

theorem surplus_part_le (v : Counts) (h : v.n4≤26) :
    surplusPart v ≤ (available v.n4 (first v) : ℝ) := by
  have hj := first_pos v
  have hj' := first_le_five v
  have he := table_checked ⟨v.n4,by omega⟩ ⟨first v-1,by omega⟩
  have hjv : first v-1+1=first v := by omega
  have hindex : 5*v.n4+(first v-1)=5*v.n4+first v-1 := by omega
  simp only [hjv,hindex] at he
  have heR : (surplusNumerators[5*v.n4+first v-1]!:ℝ)*scaleFactor ≤ (scaledAvailable v.n4 (first v):ℝ) := by exact_mod_cast he
  have hE : (0:ℝ)<scaleDen := by norm_num [scaleDen]
  apply (mul_le_mul_iff_right₀ hE).mp
  rw [available_scaled]
  have hidentity : (scaleDen:ℝ)*surplusPart v = (surplusNumerators[5*v.n4+first v-1]!:ℝ)*scaleFactor := by
    unfold surplusPart
    norm_num [scaleDen,scaleFactor,denominator]
    ring
  rw [hidentity]
  exact heR

theorem available_le (n j : ℕ) (E : ℝ) (hzero : 0≤E)
    (h1 : (credit1 n:ℝ)≤E)
    (h0 : n=24 → j≤1 → (credit0 n:ℝ)≤E)
    (h2 : n=25 → j≤4 → (credit2 n:ℝ)≤E) : (available n j:ℝ)≤E := by
  unfold available
  push_cast
  apply max_le hzero
  apply max_le h1
  apply max_le
  · split_ifs with h
    · exact h0 h.1 h.2
    · simpa using hzero
  · split_ifs with h
    · exact h2 h.1 h.2
    · simpa using hzero

#print axioms surplus_part_le
end D4Bound.SphericalSurplusTable
