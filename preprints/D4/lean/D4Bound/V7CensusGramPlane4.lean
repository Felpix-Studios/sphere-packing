      indicator (breaks.getD (i+1) 0) r).sum ≤ radialValue planeLinear4 r := by
  rw [radialValue_eq_pieceValue, radialPiece_on_support hrR]
  split_ifs with h0 h1 h2 h3 h4 h5
  · have hp := plane4piece_bound0 r (by linarith) (by linarith)
    have h1 : r ≤ (1005643/1000000 : ℝ) := by linarith
    have h2 : r ≤ (50379/50000 : ℝ) := by linarith
    have h3 : r ≤ (50767/50000 : ℝ) := by linarith
    have h4 : r ≤ (102597/100000 : ℝ) := by linarith
    norm_num [planeCounts4, List.range_succ, breaks, indicator, h0, h1, h2, h3, h4] at hp ⊢
    exact hp
  · have hp := plane4piece_bound1 r (by linarith) (by linarith)
    have h2 : r ≤ (50379/50000 : ℝ) := by linarith
    have h3 : r ≤ (50767/50000 : ℝ) := by linarith
