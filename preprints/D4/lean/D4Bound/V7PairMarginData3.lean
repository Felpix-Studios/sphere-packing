theorem marginD3_positive (x : ℝ) (hx0 : 0 ≤ x) (hx1 : x ≤ 1) :
    0 < evalZ marginD3 x := by
  by_cases hx : x < 1
  · exact chainOK_sound marginD3 marginD3Chain 0 0 1 0 (by decide +kernel) x
      (by simpa using hx0) (by simpa using hx)
  · have he : x = 1 := by linarith
    subst x
    exact leafOK_sound (P := marginD3) (A := 0) (k := 0) (h := 1)
      (by decide +kernel) 1 (by norm_num) (by norm_num)

